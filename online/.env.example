# Copy to the Render web service "Environment" then deploy. Never commit real values.
# This file lives in the online/ folder that is pushed alone to the server repo.

# --- Server ---
# online mode: enables the public registry/lobby REST API + multi-room relay.
SA_MODE=online
SA_PORT=17321
# Shared passphrase used to seed/salt room codes. Pick a long random string.
SA_PASSPHRASE=change-me
# Public origin of this Render service (invite links / auth redirects), e.g. https://space-arenas.onrender.com
SA_PUBLIC_URL=

# --- CORS (Phase 4) ---
# Comma-separated list of allowed browser origins (the GitHub Pages site), e.g.
# https://SDevRami.github.io,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
# Leave empty to allow all origins (local/LAN dev, the default). When set, the API only
# echoes Access-Control-Allow-Origin for the listed origins — browsers block everything else.
SA_CORS_ALLOW=

# --- Supabase (Phase 2) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flags (Phase 6) ---
# Community publishing (mods + maps). Leave false for the first release: the Online panel's
# Mods/Maps tabs stay readable but publish/delete/rate/comment return 403. Flip to true when
# you are ready to accept player submissions.
SA_ENABLE_PUBLISHING=false
# Tester phase. While true, only the emails in SA_TESTER_EMAILS may create a NEW account.
# Login is never affected. Set to false after testing so anyone can register.
SA_TESTERS=true
# Comma-separated emails allowed to register while SA_TESTERS=true, e.g.
# you@gmail.com,tester2@gmail.com
SA_TESTER_EMAILS=
# Reserved usernames nobody may take (comma-separated, case-insensitive). Use it to protect
# staff/official-looking handles from impersonation, e.g. sdevrami,developer,owner,admin.
SA_FORBIDDEN_USERNAME=