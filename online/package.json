{
  "name": "@space-arenas/online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space Arenas - online server (matchmaking + relay + REST/auth). Lives in the online/ folder of the space-arenas repo and is deployed on Render (rootDir: online).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/online.js --external:ws --alias:@space-arenas/shared=./shared/src/index.ts && npm run typecheck",
    "start": "node dist/online.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsx --test tests/online-server.test.ts"
  },
  "dependencies": {
    "@space-arenas/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3"
  }
}