{
  "name": "space-arenas-rts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space Arenas - LAN RTS game (Phase 1 prototype)",
  "workspaces": [
    "shared",
    "client",
    "host",
    "online"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,host -c blue,green \"npm:dev:client\" \"npm:dev:host\"",
    "dev:client": "npm run dev -w client",
    "dev:host": "npm run dev -w host",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w host",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w client && npm run typecheck -w host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:soak": "vitest run tests/determinism --pool=forks --poolOptions.forks.singleFork=true --sequence.concurrency=1 --sequence.shuffle=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:assets": "node scripts/validate-assets.mjs",
    "synth:fx": "node scripts/synth-fx.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/qrcode": "^1.5.6",
    "acorn": "^8.18.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
