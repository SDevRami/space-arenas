# --- Dependencies ---
node_modules/

# --- Build output (regenerated by `npm run build`) ---
host/dist/
*.tsbuildinfo

# --- Vite-generated files inside the tracked game-asset home ---
# client/dist IS committed (game PNG assets + sound WAVs + manifest.json).
# Only these rebuildable artifacts stay ignored:
client/dist/assets/
client/dist/index.html

# --- Secrets / local env ---
# Real values are set in the Render dashboard, never committed.
.env
.env.*
!.env.example
# Supabase / DB credentials (drop exports into online/.env, never commit)
online/supabase_keys.txt

# --- Stale transpile artifacts (built from .ts) ---
client/vite.config.js
client/src/**/*.js
shared/src/**/*.js
host/src/**/*.js

# --- OS / editor / tooling ---
.DS_Store
*.log
coverage/
.vite/
.loading-pid

# --- Runtime temp data (not shipped) ---
invites/
archive/
mods/
# Local player-profile backups (rolling localStorage snapshots).
# Anchored to the repo root: an unanchored `profile/` would also swallow the
# real source dir client/src/profile/ (which main.ts imports).
/profile/

# --- Licensed commercial webfonts (never committed) ---
# "Klapt Arabic" (SevenType) is a paid typeface. If you own a web licence you may
# drop it into the fonts folders locally; committing it would redistribute it.
# See client/public/fonts/README.txt.
client/public/fonts/*[Kk]lapt*
client/dist/fonts/*[Kk]lapt*

# --- Internal dev process (not part of the game) ---
done_list.md
AI-INSTRUCTIONS.md
# docs/ IS tracked (see docs/README.md) so anyone can read the game's systems.
# Only these internal helper files stay untracked (their knowledge is captured in
# docs/18-DEV-TOOLING.md instead).
docs/check-i18n.cjs
docs/check-registry-i18n.cjs
docs/dev-form-block.txt
# Anchored so client/src/mapbuilder (or any src maps.ts) is never matched.
/maps/
/tools/
reports/