# Copy to Render web service "Environment" then deploy. Never commit real values.
# Local LAN mode only needs SA_PORT (optional).

# --- Server ---
SA_MODE=online
SA_PORT=17321
# Shared passphrase used to seed/salt room codes. Pick a long random string.
SA_PASSPHRASE=change-me
# Public origin of this Render service (used for invite links / auth redirects).
SA_PUBLIC_URL=

# --- Supabase (Phase 2) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=